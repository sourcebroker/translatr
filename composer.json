{
  "name": "sourcebroker/translatr",
  "type": "typo3-cms-extension",
  "description": "Allows to create translation labels in BE module",
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "typo3/cms-core": "^13.4 || ^14.3",
    "typo3/cms-backend": "^13.4 || ^14.3",
    "typo3/cms-extbase": "^13.4 || ^14.3"
  },
  "autoload": {
    "psr-4": {
      "SourceBroker\\Translatr\\": "Classes/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "extra": {
    "typo3/cms": {
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/Web",
      "extension-key": "translatr"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "saschaegerer/phpstan-typo3": "^3.1",
    "friendsofphp/php-cs-fixer": "^3.95",
    "typo3/coding-standards": "^0.9.0",
    "ssch/typo3-rector": "^3.16"
  },
  "scripts": {
    "ci": [
      "@ci:php:cs-fixer",
      "@ci:php:rector",
      "@ci:php:stan"
    ],
    "fix": [
      "@fix:php:rector",
      "@fix:php:cs-fixer"
    ],
    "ci:php:stan": ".Build/bin/phpstan analyse --no-progress",
    "ci:php:cs-fixer": ".Build/bin/php-cs-fixer fix --dry-run --diff",
    "ci:php:rector": ".Build/bin/rector process --dry-run",
    "fix:php:cs-fixer": ".Build/bin/php-cs-fixer fix",
    "fix:php:rector": ".Build/bin/rector process"
  }
}
